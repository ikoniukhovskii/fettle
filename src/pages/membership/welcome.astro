---
import Page from '../../layouts/Page.astro';
import { VIDEO_CALL_URL } from '../../data/booking';
---

<Page title="Welcome to Fettle Membership | Fettle London" description="Thank you for joining Fettle Membership." noindex>
  <section class="page-hero welcome">
    <div class="wrap">
      <p class="eyebrow">Membership</p>
      <h1>Welcome to the list.</h1>
      <p class="welcome-script" id="welcome-plan">Your home is in good hands.</p>
      <p class="lede">You’re signed up, and Stripe has emailed you a receipt. Here’s what happens next.</p>
      <ol class="welcome-steps">
        <li><strong>Ilia calls you</strong> – usually the same day, always within one working day – to say hello and book your first visit.</li>
        <li><strong>Your first visit</strong> – straight away or at the start of the next season, whichever suits you. We get to know the house, run the full home check and agree your dates for the year.</li>
        <li><strong>The diary takes over</strong> – visits go in the calendar and we remind you the week before.</li>
      </ol>
      <p class="welcome-small">Want to talk sooner? <a href={VIDEO_CALL_URL} target="_blank" rel="noopener">Book a free 10-minute video call</a> or ring <a href="tel:+447361854124">07361 854124</a>.</p>
      <p><a class="btn secondary" href="/">Back to the home page</a></p>
    </div>
  </section>
</Page>

<style>
  .welcome { padding-bottom: clamp(80px, 10vw, 128px); }
  .welcome-script { margin: 6px 0 0; font-family: var(--font-script); font-size: clamp(30px, 3.4vw, 42px); color: var(--rust); transform: rotate(-1.5deg); transform-origin: left; }
  .welcome-steps { margin: 32px 0 28px; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 14px; max-width: 640px; }
  .welcome-steps li { counter-increment: s; position: relative; padding: 18px 20px 18px 64px; background: var(--white, #fff); border: 1px solid var(--ink-12); border-radius: 18px; line-height: 1.55; }
  .welcome-steps li::before { content: counter(s, decimal-leading-zero); position: absolute; left: 20px; top: 18px; font-family: var(--font-display); font-weight: 800; color: var(--rust); }
  .welcome-small { color: var(--ink-60); margin-bottom: 26px; }
  .welcome-small a { color: var(--rust); }
</style>

<script>
  import { PLANS } from '../../data/membership';
  const id = new URLSearchParams(location.search).get('plan');
  const plan = PLANS.find((p) => p.id === id);
  const el = document.getElementById('welcome-plan');
  if (plan && el) el.textContent = `${plan.name} – your home is in good hands.`;
  window.dispatchEvent(new CustomEvent('fettle:lead', { detail: { kind: `membership paid – ${plan?.name ?? 'plan'}` } }));
</script>
