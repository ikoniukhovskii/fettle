---
import Page from '../layouts/Page.astro';
---

<Page title="Contact a London Handyman – Get a Quote | Fettle" description="If you’ve something that needs doing, drop us a line. We’ll answer plainly, and if there’s room on the list near you, we’ll say so.">
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h1>Let&rsquo;s talk about your home.</h1>
        <p class="lede">If you&rsquo;ve something that needs doing, drop us a line. We&rsquo;ll answer plainly, and if there&rsquo;s room on the list near you, we&rsquo;ll say so.</p>
      </div>
    </section>

    <section class="page-body">
      <div class="wrap">
        <div class="contact-grid">
          <div class="form-card">
            <form id="contact-form" novalidate>
              <div class="field">
                <label for="cf-name">Full name</label>
                <input id="cf-name" name="name" type="text" autocomplete="name" placeholder="Francis Drake" required />
                <p class="field-error" id="cf-name-error" hidden></p>
              </div>
              <div class="field">
                <label for="cf-email">Email</label>
                <input id="cf-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
                <p class="field-error" id="cf-email-error" hidden></p>
              </div>
              <div class="field">
                <label for="cf-postcode">Postcode</label>
                <input id="cf-postcode" name="postcode" type="text" autocomplete="postal-code" placeholder="e.g. N6 4AB" />
                <p class="field-error" id="cf-postcode-error" hidden></p>
              </div>
              <div class="field">
                <label for="cf-topic">Topic</label>
                <input id="cf-topic" name="topic" type="text" placeholder="A wonky fence, a fresh coat of paint&hellip;" />
              </div>
              <div class="field">
                <label for="cf-message">How can we help?</label>
                <textarea id="cf-message" name="message" placeholder="Tell us what needs doing."></textarea>
              </div>
              <button class="btn primary" type="submit">
                Send message
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="M13 6l6 6-6 6"></path>
                </svg>
              </button>
              <div class="form-err" id="form-err" role="alert" tabindex="-1">
                <span class="bang" aria-hidden="true">!</span>
                <div>
                  <p>Nearly there &ndash; just a couple of things to fix before we can send it:</p>
                  <ul id="form-err-list"></ul>
                </div>
              </div>
              <div class="form-ok" id="form-ok" role="status">
                <span class="tick" aria-hidden="true">&#10003;</span>
                <p>Thanks. We&rsquo;ve got it, and a person &ndash; not a bot &ndash; will be in touch shortly.</p>
              </div>
            </form>
          </div>

          <div class="info-stack">
            <div class="info-card">
              <div class="head">
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.83 0l4.59-4.59a2 2 0 0 0 0-2.83Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
                </span>
                <h3>What a visit costs</h3>
              </div>
              <p>A visit to see the job and give you a price is &pound;30. Go ahead with the work, whenever you&rsquo;re ready, and it comes straight off the cost. If it&rsquo;s not a job for us, you don&rsquo;t pay.</p>
            </div>

            <div class="info-card">
              <div class="head">
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </span>
                <h3>Local team, same faces</h3>
              </div>
              <p>A small permanent team does the day-to-day work, so it&rsquo;s the same faces each visit. People who know where the stopcock is.</p>
            </div>

            <div class="info-card">
              <div class="head">
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                </span>
                <h3>Vetted specialists</h3>
              </div>
              <p>Rendering and tree surgery go to specialists we know by name and have used before.</p>
            </div>

            <div class="info-card">
              <div class="head">
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4"></path><path d="M8 2v4"></path><path d="M3 10h18"></path></svg>
                </span>
                <h3>Seasonal upkeep</h3>
              </div>
              <p>The once-a-season look-over that stops small things becoming big ones.</p>
            </div>

            <div class="info-card">
              <div class="head">
                <span class="ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </span>
                <h3>Rather just call?</h3>
              </div>
              <p><a href="tel:+447361854124">+44 7361 854124</a> &middot; <a href="https://wa.me/447361854124">WhatsApp</a><br />Weekdays, 8am&ndash;6pm. Covering north, northwest, west, southwest, south, and central London.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { persistSession: false } }
  );

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const ok = document.getElementById('form-ok');
  const err = document.getElementById('form-err');
  const errList = document.getElementById('form-err-list');

  // Something@something.something – enough to catch a half-typed address.
  const EMAIL_RE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)*\.[a-z]{2,}$/i;
  // Royal Mail format: outward code (e.g. N6, SW1A, EC1V) then inward code (e.g. 4AB).
  const POSTCODE_RE = /^(GIR0AA|[A-PR-UWYZ]([0-9]{1,2}|[A-HK-Y][0-9]{1,2}|[0-9][A-HJKPSTUW]|[A-HK-Y][0-9][ABEHMNPRVWXY])[0-9][ABD-HJLNP-UW-Z]{2})$/;

  function normalisePostcode(value: string): string | null {
    const compact = value.replace(/\s+/g, '').toUpperCase();
    if (!POSTCODE_RE.test(compact)) return null;
    return `${compact.slice(0, -3)} ${compact.slice(-3)}`;
  }

  function setFieldError(field: HTMLInputElement, message: string | null) {
    const note = document.getElementById(`${field.id}-error`);
    field.closest('.field')?.classList.toggle('has-error', !!message);
    if (message) {
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', `${field.id}-error`);
    } else {
      field.removeAttribute('aria-invalid');
      field.removeAttribute('aria-describedby');
    }
    if (note) {
      note.textContent = message ?? '';
      note.hidden = !message;
    }
  }

  function clearErrors() {
    form?.querySelectorAll<HTMLInputElement>('[aria-invalid]').forEach((f) => setFieldError(f, null));
    err?.classList.remove('show');
  }

  function showErrors(problems: [HTMLInputElement, string][]) {
    if (errList) errList.replaceChildren();
    for (const [field, message] of problems) {
      setFieldError(field, message);
      const item = document.createElement('li');
      item.textContent = message;
      item.dataset.field = field.id;
      errList?.append(item);
    }
    err?.classList.add('show');
    problems[0][0].focus();
  }

  // Clear a field's error as soon as it's edited.
  form?.addEventListener('input', (e) => {
    const field = e.target as HTMLInputElement;
    if (field.getAttribute('aria-invalid')) {
      setFieldError(field, null);
      errList?.querySelector(`[data-field="${field.id}"]`)?.remove();
    }
    if (!form.querySelector('[aria-invalid]')) err?.classList.remove('show');
  });

  const prefillPostcode = new URLSearchParams(window.location.search).get('postcode');
  if (prefillPostcode) {
    const postcodeField = document.getElementById('cf-postcode') as HTMLInputElement | null;
    if (postcodeField) postcodeField.value = prefillPostcode;
    const nameField = document.getElementById('cf-name') as HTMLInputElement | null;
    nameField?.focus();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('cf-name') as HTMLInputElement;
    const email = document.getElementById('cf-email') as HTMLInputElement;
    const postcode = document.getElementById('cf-postcode') as HTMLInputElement;
    const topic = document.getElementById('cf-topic') as HTMLInputElement;
    const message = document.getElementById('cf-message') as HTMLTextAreaElement;

    clearErrors();
    ok?.classList.remove('show');

    const problems: [HTMLInputElement, string][] = [];
    if (!name.value.trim()) problems.push([name, 'We’ll need a name to put to the job.']);

    const emailValue = email.value.trim();
    if (!emailValue) problems.push([email, 'We’ll need an email address to reply to.']);
    else if (!EMAIL_RE.test(emailValue)) problems.push([email, 'Your email looks incomplete. It needs an @ and a domain, like name@example.co.uk.']);

    const postcodeValue = postcode.value.trim();
    if (postcodeValue) {
      const normalised = normalisePostcode(postcodeValue);
      if (normalised) postcode.value = normalised;
      else problems.push([postcode, 'That doesn’t look like a UK postcode. Try something like N6\u00A04AB.']);
    }

    if (problems.length) return showErrors(problems);

    const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submit.disabled = true;

    const { error } = await supabase.from('contact_submissions').insert({
      full_name: name.value.trim(),
      email: email.value.trim(),
      postcode: postcode.value.trim(),
      topic: topic.value.trim(),
      message: message.value.trim(),
    });

    if (error) {
      console.error('Form submission failed:', error);
      submit.disabled = false;
      alert("Sorry, something went wrong sending your message. Please try again, or call/WhatsApp us instead.");
      return;
    }

    ok?.classList.add('show');
    form.reset();
  });
</script>
</Page>
