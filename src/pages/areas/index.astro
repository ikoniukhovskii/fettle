---
import Page from '../../layouts/Page.astro';
import CoverageMap from '../../components/CoverageMap.astro';
import { REGIONS, hoodsIn, hoodUrl, hoodTravel } from '../../data/areas';
import { AREAS } from '../../data/services';
import { CONGESTION_CHARGE } from '../../data/travel';
---

<Page title="Areas We Cover – Handyman in Chelsea, Kensington, Fulham & London | Fettle London" description="Handyman and home maintenance across southwest, west and central London: Chelsea, Fulham, Kensington, Battersea, Notting Hill, Pimlico and more. No travel charge.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Areas we cover</p>
      <h1>Close to home, mostly.</h1>
      <p class="lede">We’re based in Chelsea, SW10. Every neighbourhood below is within four miles – a short drive, the same small team, and never a travel charge.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <CoverageMap id="cov-hub" caption="Tap any dot to see that neighbourhood. Drag and zoom to look around." />

      {REGIONS.map((r) => (
        <section class="region-block">
          <header>
            <div>
              <h2>{r.name}</h2>
              <p>{r.lede}</p>
            </div>
            <a href={`/areas/${r.slug}`}>All of {r.name} →</a>
          </header>
          <div class="hood-grid">
            {hoodsIn(r).map((h) => {
              const t = hoodTravel(h);
              return (
                <a class="hood-card" href={hoodUrl(h)}>
                  <span class="pc">{h.postcodes.join(' · ')}</span>
                  <h3>{h.name}</h3>
                  <div class="meta"><span>{t.miles} miles · <b>{t.fee === 0 ? 'no travel charge' : `£${t.fee} travel`}{t.congestion ? ` + £${CONGESTION_CHARGE} congestion` : ''}</b></span><span class="go">→</span></div>
                </a>
              );
            })}
          </div>
        </section>
      ))}

      <div class="area-section prose" style="max-width:none">
        <h2 style="font-family:var(--font-display);font-weight:800;font-size:clamp(26px,3.4vw,36px);margin:0 0 14px">Further afield</h2>
        <p>We also look after homes across the rest of London. Further out, a small flat travel charge covers time on the road – you’ll always see it on your quote first. Inside the Congestion Charge zone (Mayfair, Soho, Marylebone, Westminster, the City and so on), the £{CONGESTION_CHARGE} daily charge is added at cost for each day we drive in.</p>
        <ul class="area-links">
          {AREAS.filter((a) => !['West London', 'Southwest London', 'Central London'].includes(a.region)).map((a) => (
            <li><strong>{a.region}:</strong> {a.places}</li>
          ))}
        </ul>
        <p style="margin-top:24px"><a class="btn primary" href="/contact">Check your postcode</a></p>
      </div>
    </div>
  </section>
</Page>
