---
import { TRACKERS, TRACKING_ENABLED } from '../data/trackers';
const names = [TRACKERS.ga4 && 'Google Analytics', TRACKERS.metaPixel && 'Meta', TRACKERS.clarity && 'Microsoft Clarity'].filter(Boolean) as string[];
const list = names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}` : names[0];
---
{TRACKING_ENABLED && (
  <div class="consent-overlay" id="consent" hidden>
    <div class="consent" role="dialog" aria-modal="true" aria-labelledby="consent-title" aria-describedby="consent-text">
      <svg class="consent-mark" viewBox="12 12 104 104" aria-hidden="true"><rect x="12" y="12" width="104" height="104" rx="24" fill="#B34426"/><rect x="46" y="34" width="14" height="60" fill="#F1E8D8"/><rect x="46" y="34" width="34" height="14" fill="#F1E8D8"/><rect x="46" y="60" width="28" height="14" fill="#F1E8D8"/></svg>
      <p class="consent-title" id="consent-title">Mind if we count your visit?</p>
      <p class="consent-text" id="consent-text">With your OK we use {list} to see how people find Fettle and which pages help. Nothing is sold, and you can change your mind any time. <a href="/cookies">More about cookies</a></p>
      <div class="consent-btns">
        <button type="button" data-consent="no">No thanks</button>
        <button type="button" data-consent="yes" class="yes">That’s fine</button>
      </div>
    </div>
  </div>
  <script is:inline define:vars={{ T: TRACKERS }}>
    (function () {
      var KEY = 'fettle-consent';
      var box = document.getElementById('consent');
      var loaded = false;
      function get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } }
      function set(v) { try { localStorage.setItem(KEY, JSON.stringify({ analytics: v, at: Date.now() })); } catch (e) {} }
      function add(src, attrs) { var s = document.createElement('script'); s.async = true; s.src = src; for (var k in attrs || {}) s.setAttribute(k, attrs[k]); document.head.appendChild(s); }
      function mine() {
        try { return localStorage.getItem('fettle-owner') === '1' || !/^(www\.)?fettlelondon\.com$/.test(location.hostname); } catch (e) { return false; }
      }
      function load() {
        if (loaded) return; loaded = true;
        if (mine()) return; // your own devices and test copies: no Google, Meta or Clarity at all
        if (T.ga4) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', T.ga4);
          add('https://www.googletagmanager.com/gtag/js?id=' + T.ga4);
        }
        if (T.metaPixel) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', T.metaPixel);
          fbq('track', 'PageView');
        }
        if (T.clarity) {
          (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,'clarity','script',T.clarity);
          window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
        }
      }
      // Enquiries count as "leads" in Google and Meta, so you can see which visits turn into work.
      window.addEventListener('fettle:lead', function (e) {
        var kind = (e.detail && e.detail.kind) || 'enquiry';
        if (window.gtag) gtag('event', 'generate_lead', { lead_type: kind });
        if (window.fbq) fbq('track', 'Lead', { content_name: kind });
      });
      function show() { box.hidden = false; document.documentElement.style.overflow = 'hidden'; var y = box.querySelector('.yes'); if (y) setTimeout(function () { y.focus(); }, 50); }
      function hide() { box.hidden = true; document.documentElement.style.overflow = ''; }
      window.fettleConsent = { open: show };
      // Keep keyboard focus inside the banner while it's open.
      box.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab') return;
        var f = box.querySelectorAll('a, button'); var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
      // The cookies page stays readable, so people can check the details before choosing.
      var onCookiesPage = /^\/cookies\/?$/.test(location.pathname);
      var c = get();
      if (c && c.analytics) load();
      else if (!c && !onCookiesPage) show();
      box.addEventListener('click', function (e) {
        var b = e.target.closest('[data-consent]'); if (!b) return;
        var yes = b.getAttribute('data-consent') === 'yes';
        set(yes); hide();
        if (yes) { load(); window.dispatchEvent(new Event('fettle:consent')); }
      });
    })();
  </script>
  <style>
    .consent-overlay { position: fixed; inset: 0; z-index: 2147483600; display: grid; place-items: center; padding: 20px; background: rgba(28, 24, 21, .55); backdrop-filter: blur(4px) saturate(.7); -webkit-backdrop-filter: blur(4px) saturate(.7); animation: cIn .35s ease both; }
    .consent-overlay[hidden] { display: none; }
    @keyframes cIn { from { opacity: 0; } to { opacity: 1; } }
    .consent { width: min(480px, 100%); padding: 34px 34px 28px; border-radius: 26px; background: #2B2723; color: #F1E8D8; text-align: center; box-shadow: 0 40px 90px -20px rgba(0,0,0,.6), inset 0 0 0 1px rgba(233,165,142,.3); font-family: var(--font-body, 'Work Sans', sans-serif); animation: cUp .45s cubic-bezier(.2,.8,.2,1) both; }
    @keyframes cUp { from { opacity: 0; transform: translateY(18px) scale(.97); } to { opacity: 1; transform: none; } }
    .consent-mark { width: 52px; height: 52px; }
    .consent-title { margin: 16px 0 0; font-family: var(--font-display, sans-serif); font-weight: 800; font-size: clamp(24px, 3vw, 30px); line-height: 1.15; }
    .consent-text { margin: 12px auto 24px; max-width: 38ch; font-size: 15.5px; line-height: 1.6; color: rgba(241,232,216,.75); }
    .consent-text a { color: #E9A58E; }
    .consent-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .consent-btns button { cursor: pointer; padding: 15px 18px; border-radius: 999px; font: 600 16px var(--font-body, sans-serif); border: 1.5px solid rgba(241,232,216,.45); background: transparent; color: #F1E8D8; transition: background .15s, border-color .15s; }
    .consent-btns button:hover { border-color: #F1E8D8; }
    .consent-btns .yes { background: #B34426; border-color: #B34426; }
    .consent-btns .yes:hover { background: #97381E; border-color: #97381E; }
    .consent-btns button:focus-visible { outline: 2px solid #E9A58E; outline-offset: 3px; }
    @media (max-width: 420px) { .consent { padding: 28px 22px 22px; } .consent-btns { grid-template-columns: 1fr; } .consent-btns .yes { order: -1; } }
    @media (prefers-reduced-motion: reduce) { .consent-overlay, .consent { animation: none; } }
  </style>
)}
