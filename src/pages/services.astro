---
import Page from '../layouts/Page.astro';
import { SERVICES } from '../data/services';
---

<Page title="Handyman Services in London – What We Fix | Fettle" description="From a wonky fence to a fresh coat of paint, or a deep clean when you move out, one team does the lot – and for rendering or tree surgery, specialists we know by name.">
    <section class="page-hero">
      <div class="wrap">
        <p class="eyebrow">Services</p>
        <h1>One team, most jobs.</h1>
        <p class="lede">From a wonky fence to a fresh coat of paint, or a deep clean when you move out, one team does the lot &ndash; and for rendering or tree surgery, specialists we know by name.</p>
      </div>
    </section>

    <section class="page-body">
      <div class="wrap">
        <div class="grid three">
          {SERVICES.map((s) => (
            <a class="card" href={`/services/${s.slug}`} style="text-decoration:none; color:inherit">
              <h3>{s.name}</h3>
              <p>{s.lede}</p>
              <p style="margin-top:12px; color:var(--brick)">More &rarr;</p>
            </a>
          ))}
        </div>

        <hr class="divider" />

        <div class="prose">
          <h2>Specialist work, personally vetted</h2>
          <p>For the jobs that call for a specialist &ndash; rendering, tree surgery &ndash; we bring in people we know by name and have used before. Same standard, same tidy finish, every job carrying a reputation.</p>
          <div class="badge-row">
            <span class="pill"><span class="dot"></span>Visit and quote &middot; &pound;30</span>
            <span class="pill"><span class="dot"></span>Half-day &middot; from &pound;140</span>
            <span class="pill"><span class="dot"></span>&pound;30 back off your job</span>
            <span class="pill"><span class="dot"></span>Tidy finish</span>
          </div>
          <p style="margin-top:24px"><a class="btn primary" href="/how-it-works">See how it works</a></p>
        </div>
      </div>
    </section>
</Page>
