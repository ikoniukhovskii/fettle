---
// The customer's side of the review system. Reached from the stars in the "How did we do?"
// email (/review?t=TOKEN&s=5) or from the QR card left at the job (/review, no token).
import Page from '../layouts/Page.astro';
import { GOOGLE_REVIEW_URL } from '../data/reviews';
---

<Page title="How did we do? | Fettle London" description="Tell us how your Fettle visit went." noindex>
  <section class="rv">
    <div class="wrap rv-wrap">
      <p class="eyebrow" id="rv-eyebrow">Your Fettle visit</p>
      <h1 class="rv-h1" id="rv-h1">How did we do?</h1>
      <p class="rv-lede" id="rv-lede">One tap tells me how it went. I read every answer myself.</p>

      <div class="rv-card" id="rv-pick">
        <label class="rv-name" id="rv-namewrap" hidden>
          <span>Your first name <em>(optional)</em></span>
          <input id="rv-name" type="text" maxlength="60" autocomplete="given-name" />
        </label>
        <div class="rv-stars" role="radiogroup" aria-label="Your rating">
          {[1, 2, 3, 4, 5].map((n) => (
            <button type="button" class="rv-star" data-s={n} role="radio" aria-checked="false" aria-label={`${n} out of 5`}>
              <span class="rv-glyph" aria-hidden="true">★</span>
              <span class="rv-lab">{['Not good', 'Meh', 'OK', 'Good', 'Spot on'][n - 1]}</span>
            </button>
          ))}
        </div>
        <p class="rv-err" id="rv-err" hidden></p>
      </div>

      <!-- 4–5 stars -->
      <div class="rv-card" id="rv-happy" hidden>
        <h2>Brilliant – you’ve made my day.</h2>
        <p class="rv-sub">What stood out? Tap any that fit and I’ll turn them into a few words for you.</p>
        <div class="rv-chips" id="rv-chips">
          <button type="button" data-p="turned up bang on time">On time</button>
          <button type="button" data-p="left everything spotless">Tidy finish</button>
          <button type="button" data-p="friendly and easy to deal with">Friendly</button>
          <button type="button" data-p="really careful, quality work">Quality work</button>
          <button type="button" data-p="sorted it first time">Sorted first time</button>
          <button type="button" data-p="kept me updated throughout">Kept me updated</button>
          <button type="button" data-p="fairly priced">Fair price</button>
          <button type="button" data-p="would definitely recommend">Would recommend</button>
        </div>
        <label class="rv-label" for="rv-text-happy">Your words <em>(change anything you like)</em></label>
        <textarea id="rv-text-happy" rows="4" maxlength="1500" placeholder="Tap a few of the buttons above, or write your own…"></textarea>
        <label class="rv-check"><input type="checkbox" id="rv-pub" /> Happy for Fettle to show this on the website (first name only)</label>
        <div class="rv-actions">
          {GOOGLE_REVIEW_URL
            ? <><button type="button" class="btn primary" id="rv-google">Copy &amp; post on Google</button><button type="button" class="btn secondary" id="rv-send-happy">Just send it to Ilia</button></>
            : <button type="button" class="btn primary" id="rv-send-happy">Send to Ilia</button>}
        </div>
        {GOOGLE_REVIEW_URL && <p class="rv-note">“Copy &amp; post” copies your words and opens Google, so you only need to paste and pick your stars. Takes about 30 seconds and helps a small business more than you’d think.</p>}
      </div>

      <!-- 1–3 stars -->
      <div class="rv-card" id="rv-sad" hidden>
        <h2>Thanks for being honest.</h2>
        <p class="rv-sub">What should I have done better? This comes straight to me, and if something needs putting right, I’ll come back and sort it.</p>
        <textarea id="rv-text-sad" rows="5" maxlength="1500" placeholder="What went wrong, or what would have made it a five?"></textarea>
        <div class="rv-actions"><button type="button" class="btn primary" id="rv-send-sad">Send to Ilia</button></div>
        {GOOGLE_REVIEW_URL && <p class="rv-note">You’re also welcome to <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener" id="rv-google-sad">leave a public review on Google</a>.</p>}
      </div>

      <!-- finished -->
      <div class="rv-card rv-done" id="rv-done" hidden>
        <p class="rv-big" aria-hidden="true">🛠️</p>
        <h2 id="rv-done-h">Thank you.</h2>
        <p class="rv-sub" id="rv-done-p">That’s everything – I really appreciate it.</p>
        <a class="btn secondary" href="/">Back to Fettle</a>
      </div>
    </div>
  </section>
</Page>

<style is:global>
  .rv { padding: clamp(44px, 7vw, 88px) 0 clamp(64px, 8vw, 110px); }
  .rv-wrap { max-width: 640px; }
  .rv-h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(36px, 6vw, 56px); line-height: 1.04; letter-spacing: -.02em; margin: 0; }
  .rv-lede { color: var(--ink-60); margin: 14px 0 26px; }
  .rv-card { background: var(--white); border-radius: 22px; padding: clamp(18px, 4vw, 28px); border: 1px solid var(--ink-08); margin-bottom: 16px; }
  .rv-card h2 { font-family: var(--font-display); font-weight: 800; font-size: 24px; letter-spacing: -.01em; margin: 0 0 6px; }
  .rv-sub { color: var(--ink-60); margin: 0 0 18px; font-size: 15px; }
  .rv-stars { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .rv-star { border: 0; border-radius: 16px; background: var(--cream); padding: 14px 4px 12px; cursor: pointer; font: inherit; color: var(--ink); transition: transform .15s ease, background .15s ease; }
  .rv-star:hover { transform: translateY(-2px); }
  .rv-glyph { display: block; font-size: clamp(26px, 6vw, 34px); line-height: 1; color: var(--ink-12); transition: color .15s ease, transform .2s ease; }
  .rv-lab { display: block; margin-top: 6px; font-size: 12px; font-weight: 600; }
  .rv-star.on .rv-glyph { color: var(--rust); }
  .rv-star[aria-checked="true"] { background: var(--rust-tint); }
  .rv-star[aria-checked="true"] .rv-glyph { transform: scale(1.18); }
  .rv-name { display: block; margin-bottom: 16px; }
  .rv-name[hidden] { display: none; }
  .rv-name span, .rv-label { display: block; font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .rv-name em, .rv-label em { font-style: normal; font-weight: 400; color: var(--ink-60); }
  .rv-name input, .rv-card textarea { width: 100%; padding: 12px 14px; border-radius: 14px; border: 1.5px solid var(--ink-12); background: var(--cream); font: inherit; color: var(--ink); box-sizing: border-box; }
  .rv-card textarea { resize: vertical; line-height: 1.55; }
  .rv-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .rv-chips button { border: 1.5px solid var(--ink-12); background: var(--white); border-radius: 999px; padding: 9px 14px; font: 600 14px/1 var(--font-body); color: var(--ink); cursor: pointer; }
  .rv-chips button[aria-pressed="true"] { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .rv-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--ink-60); margin: 14px 0 18px; }
  .rv-check input { margin-top: 3px; accent-color: var(--rust); }
  .rv-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .rv-note { font-size: 13.5px; color: var(--ink-60); margin: 14px 0 0; }
  .rv-err { color: var(--brick); font-size: 14px; margin: 14px 0 0; }
  .rv-done { text-align: center; padding: 34px 24px; }
  .rv-big { font-size: 44px; margin: 0 0 8px; }
  @keyframes rv-pop { 0% { transform: scale(.6); opacity: 0 } 70% { transform: scale(1.08) } 100% { transform: scale(1); opacity: 1 } }
  .rv-pop { animation: rv-pop .35s ease both; }
</style>

<script>
  import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../data/supabase-config';
  import { GOOGLE_REVIEW_URL } from '../data/reviews';

  const $ = (id: string) => document.getElementById(id) as any;
  const qs = new URLSearchParams(location.search);
  let token = /^[0-9a-f-]{36}$/i.test(qs.get('t') || '') ? qs.get('t')! : '';
  let rating = 0, job = '', who = '';

  async function call(body: Record<string, unknown>) {
    const res = await fetch(`${SUPABASE_URL}/functions/v1/reviews`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
      body: JSON.stringify(body),
    }).catch(() => null);
    const j = res ? await res.json().catch(() => ({})) : { error: 'Couldn’t reach the server – please try again.' };
    if (!res || !res.ok) throw new Error(j.error || 'Something went wrong – please try again.');
    return j;
  }
  const fail = (e: unknown) => { const el = $('rv-err'); el.textContent = (e as Error).message; el.hidden = false; };

  const starBtns = [...document.querySelectorAll<HTMLButtonElement>('.rv-star')];
  function paint(n: number) {
    starBtns.forEach((b) => {
      const s = +b.dataset.s!;
      b.classList.toggle('on', s <= n);
      b.setAttribute('aria-checked', String(s === n));
    });
  }
  // Hover preview on desktop.
  starBtns.forEach((b) => {
    b.addEventListener('mouseenter', () => starBtns.forEach((x) => x.classList.toggle('on', +x.dataset.s! <= +b.dataset.s!)));
    b.addEventListener('mouseleave', () => paint(rating));
    b.addEventListener('click', () => choose(+b.dataset.s!));
  });

  function showFollowUp() {
    $('rv-happy').hidden = rating < 4;
    $('rv-sad').hidden = rating >= 4;
    const card = rating >= 4 ? $('rv-happy') : $('rv-sad');
    card.classList.remove('rv-pop'); void card.offsetWidth; card.classList.add('rv-pop');
    $('rv-lede').textContent = rating >= 4 ? 'Thank you! One more (optional) step below.' : 'Thank you for telling me. One more (optional) step below.';
  }

  async function choose(n: number) {
    $('rv-err').hidden = true;
    const prev = rating;
    rating = n; paint(n);
    try {
      if (!token) {
        const j = await call({ action: 'start', rating: n, name: ($('rv-name') as HTMLInputElement).value });
        token = j.token;
        $('rv-namewrap').hidden = true;
      } else {
        await call({ action: 'rate', token, rating: n });
      }
      showFollowUp();
    } catch (e) { rating = prev; paint(prev); fail(e); }
  }

  // Chips build a draft the customer can edit.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#rv-chips button')];
  const draft = $('rv-text-happy') as HTMLTextAreaElement;
  let touched = false;
  draft.addEventListener('input', () => { touched = true; });
  function rebuild() {
    if (touched) return;
    const picked = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.p!);
    if (!picked.length) { draft.value = ''; return; }
    const list = picked.length > 1 ? `${picked.slice(0, -1).join(', ')} and ${picked.at(-1)}` : picked[0];
    const lead = job ? `Ilia from Fettle ${job.charAt(0).toLowerCase() + job.slice(1)}. ` : 'Used Fettle London and was really pleased. ';
    draft.value = `${lead}${list.charAt(0).toUpperCase() + list.slice(1)}.`;
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    c.setAttribute('aria-pressed', String(c.getAttribute('aria-pressed') !== 'true'));
    rebuild();
  }));

  function done(h: string, p: string) {
    ['rv-pick', 'rv-happy', 'rv-sad'].forEach((id) => ($(id).hidden = true));
    $('rv-done-h').textContent = h; $('rv-done-p').textContent = p;
    $('rv-done').hidden = false; $('rv-done').classList.add('rv-pop');
    $('rv-lede').textContent = '';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function sendText(text: string, publish: boolean) {
    if (!text.trim()) return;
    await call({ action: 'feedback', token, text, publish });
  }

  $('rv-send-happy')?.addEventListener('click', async () => {
    try {
      await sendText(draft.value, ($('rv-pub') as HTMLInputElement).checked);
      done(`Thank you${who ? `, ${who}` : ''}!`, 'That’s made my week. See you next time something needs fettling.');
    } catch (e) { fail(e); }
  });
  $('rv-send-sad')?.addEventListener('click', async () => {
    try {
      await sendText(($('rv-text-sad') as HTMLTextAreaElement).value, false);
      done('Thank you for telling me.', 'I’ll be in touch shortly to put it right.');
    } catch (e) { fail(e); }
  });
  $('rv-google')?.addEventListener('click', async () => {
    const text = draft.value.trim();
    // Open the tab first (inside the click) so browsers don't block it.
    const tab = window.open(GOOGLE_REVIEW_URL, '_blank', 'noopener');
    if (text) { try { await navigator.clipboard.writeText(text); } catch {} }
    call({ action: 'google', token }).catch(() => {});
    sendText(text, ($('rv-pub') as HTMLInputElement).checked).catch(() => {});
    if (!tab) location.href = GOOGLE_REVIEW_URL;
    done('You’re a star.', text ? 'Your words are copied – on Google, just paste them, pick your stars and post. Thank you!' : 'On Google, pick your stars, add a few words and post. Thank you!');
  });
  $('rv-google-sad')?.addEventListener('click', () => { call({ action: 'google', token }).catch(() => {}); });

  // Start: from an email link, load their name and record the star they tapped.
  (async () => {
    if (!token) { $('rv-namewrap').hidden = false; $('rv-lede').textContent = 'Tap a star – it takes ten seconds, and I read every answer myself.'; return; }
    try {
      const v = await call({ action: 'view', token });
      who = v.name || ''; job = v.job || '';
      if (who) $('rv-h1').textContent = `How did we do, ${who}?`;
      const s = Number(qs.get('s'));
      if (s >= 1 && s <= 5) await choose(s);
      else if (v.rating) { rating = v.rating; paint(rating); showFollowUp(); }
    } catch (e) { fail(e); }
  })();
</script>
