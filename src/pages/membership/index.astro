---
import Page from '../../layouts/Page.astro';
import { PLANS, HOME_CHECK, MONTHS, EXTRAS, yearlyPrice, fmt } from '../../data/membership';
import MadeToMeasure from '../../components/MadeToMeasure.astro';
import { VIDEO_CALL_URL } from '../../data/booking';
import { PAYMENTS_ENABLED } from '../../data/payments';
const memSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'In Fine Fettle – home maintenance membership',
  serviceType: 'Home maintenance plan',
  description: 'Scheduled home maintenance in London from one small team: seasonal home checks, gutters, seals, damp and your list worked through.',
  url: 'https://www.fettlelondon.com/membership',
  provider: { '@type': 'HandymanService', name: 'Fettle London', url: 'https://www.fettlelondon.com' },
  areaServed: { '@type': 'City', name: 'London' },
  offers: PLANS.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: `${p.cadence}. ${p.blurb}`,
    priceCurrency: 'GBP',
    price: p.price,
    priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price, priceCurrency: 'GBP', unitText: 'MONTH', billingDuration: 'P1M' },
  })),
};
const featured = PLANS.find((p) => p.featured) ?? PLANS[0];
---

<Page title="Home Maintenance Membership in London | Fettle" description="In Fine Fettle – a home maintenance plan from Fettle. The same small team on a schedule: seasonal home checks, gutters, seals and your list, from £29 a month.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(memSchema)} />
  <section class="mem-hero">
    <div class="wrap mem-hero-grid">
      <div>
        <p class="mem-eyebrow">Membership</p>
        <h1>Your home, kept <span class="script">in fine fettle</span> all year.</h1>
        <p class="aside" aria-live="polite">
          <svg class="aside-arrow" viewBox="0 0 60 40" aria-hidden="true"><path d="M4 6 C 18 30, 36 34, 52 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M44 18 L53 21 L48 29" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span id="aside-line">Like a streaming subscription – except each season’s new episode is your gutters, cleared.</span>
        </p>
        <p class="mem-lede">Rather than waiting for something to give, we come round on a schedule. The same faces, the same checklist, and your list worked through as it grows.</p>
        <div class="mem-cta">
          <a class="mem-btn" href="#plans">See the plans</a>
          <a class="mem-link" href="#join">Request a place</a>
        </div>
        <p class="mem-small">From £29 a month · a limited number of homes each season</p>
      </div>
      <div class="mcard-wrap" aria-hidden="true">
        <div class="mcard">
          <div class="mcard-top">
            <svg viewBox="12 12 104 104" class="mcard-mark"><rect x="12" y="12" width="104" height="104" rx="24" fill="#B34426"/><rect x="46" y="34" width="14" height="60" fill="#F1E8D8"/><rect x="46" y="34" width="34" height="14" fill="#F1E8D8"/><rect x="46" y="60" width="28" height="14" fill="#F1E8D8"/></svg>
            <span class="mcard-kind">Member</span>
          </div>
          <p class="mcard-script">in fine fettle</p>
          <div class="mcard-rows">
            <div><span>Plan</span><strong id="mcard-plan">{featured.name}</strong></div>
            <div><span>Visits</span><strong id="mcard-visits">{featured.cadence}</strong></div>
          </div>
          <div class="mcard-foot"><span>Fettle London</span><span>Est. 2023</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mem-familiar" aria-labelledby="familiar-h">
    <div class="wrap">
      <p class="eyebrow">Sound familiar?</p>
      <h2 class="mem-h2" id="familiar-h">The list that never gets shorter.</h2>
      <ul class="fridge" id="fridge">
        <li><span>The gutter you meant to clear last autumn</span></li>
        <li><span>A drip you’ve stopped hearing</span></li>
        <li><span>Sealant going black around the bath</span></li>
        <li><span>The door that sticks every winter</span></li>
        <li><span>That crack you’re keeping an eye on</span></li>
      </ul>
      <p class="fridge-after">Membership means someone else remembers – and crosses them off.</p>
    </div>
  </section>

  <section class="mem-year">
    <div class="wrap">
      <p class="eyebrow">A year with Fettle</p>
      <h2 class="mem-h2">The diary does the remembering.</h2>
      <div class="seg" role="tablist" aria-label="Choose a plan to see its visits">
        {PLANS.map((p) => (
          <button type="button" role="tab" data-plan={p.id} aria-selected={p.featured ? 'true' : 'false'}>{p.name}</button>
        ))}
      </div>
      <ol class="months" id="months">
        {MONTHS.map((m, i) => (
          <li data-month={i}><span class="mname">{m}</span><span class="dot" aria-hidden="true"></span></li>
        ))}
      </ol>
      <p class="legend"><span class="lg check"></span>Full home check <span class="lg list"></span>Visit for your list</p>
    </div>
  </section>

  <section class="mem-plans" id="plans">
    <div class="wrap">
      <p class="eyebrow">The plans</p>
      <h2 class="mem-h2">Three ways to keep the house in order.</h2>
      <div class="billing" role="radiogroup" aria-label="How you’d like to pay">
        <button type="button" role="radio" aria-checked="true" data-billing="month">Pay monthly</button>
        <button type="button" role="radio" aria-checked="false" data-billing="year">Pay yearly <span class="billing-gift">two months on us</span></button>
      </div>
      <div class="plans" data-billing-view="month">
        {PLANS.map((p) => (
          <article class={`plan${p.featured ? ' is-featured' : ''}`}>
            {p.featured && <span class="plan-tag">Our suggestion</span>}
            <h3>{p.name}</h3>
            <p class="plan-cad">{p.cadence}</p>
            <p class="plan-price only-month"><span class="cur">£</span>{p.price}<span class="per">/month</span></p>
            <p class="plan-price only-year"><span class="cur">£</span>{yearlyPrice(p).toLocaleString('en-GB')}<span class="per">/year</span></p>
            <p class="plan-save only-year"><s>{fmt(p.price * 12)}</s> twelve months for the price of ten</p>
            <p class="plan-worth">Worth {fmt(p.worth)}+ a year at our usual prices</p>
            <p class="plan-blurb">{p.blurb}</p>
            <ul>{p.perks.map((x) => <li>{x}</li>)}</ul>
            {p.choosesExtra && (
              <div class="plan-extra">
                <p class="plan-extra-h">Your extra – you choose</p>
                <p class="plan-extra-list">Spring jet wash · Carpets cleaned · An extra hour every visit</p>
              </div>
            )}
            <a class={`plan-btn${p.featured ? ' solid' : ''}`} href={`#join`} data-choose={p.id}>Choose {p.name}</a>
          </article>
        ))}
      </div>
      <MadeToMeasure />
      <p class="mem-note">Plans run for twelve months, paid monthly or once for the year. Materials at cost. No travel charge on plan visits. We don’t do gas, boiler or electrical work.</p>
    </div>
  </section>

  <section class="mem-diff" aria-labelledby="diff-h">
    <div class="wrap">
      <p class="eyebrow">What you’re paying for</p>
      <h2 class="mem-h2" id="diff-h">Not a place in the queue. The work itself.</h2>
      <div class="diff-grid">
        <div class="diff-col diff-them">
          <p class="diff-label">Most home memberships</p>
          <ul>
            <li>A small monthly fee buys priority and no call-out charge</li>
            <li>The work is billed on top, usually by the hour</li>
            <li>A different tradesperson each time</li>
            <li>Nothing happens unless something breaks</li>
          </ul>
        </div>
        <div class="diff-col diff-us">
          <p class="diff-label">A Fettle membership</p>
          <ul>
            <li>Your monthly price pays for the visits themselves</li>
            <li>The home check and your list, done on each visit</li>
            <li>The same small team, who know the house</li>
            <li>We come round on schedule – before things break</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mem-check">
    <div class="wrap mem-check-grid">
      <div>
        <p class="eyebrow">The home check</p>
        <h2 class="mem-h2">Fourteen things, every time.</h2>
        <p class="mem-body">The same checklist on every full visit, so nothing slips. You get a short written note afterwards – what we found, what we fixed, and anything worth keeping an eye on.</p>
      </div>
      <ul class="checklist">
        {HOME_CHECK.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="mem-how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <div class="steps">
        <div><span class="n">01</span><h3>Request a place</h3><p>Tell us about the house. We take on a limited number of homes each season, so the diary works.</p></div>
        <div><span class="n">02</span><h3>A first visit</h3><p>We come round, get to know the house and agree your dates. For members, the usual £30 visit is free.</p></div>
        <div><span class="n">03</span><h3>The diary takes over</h3><p>Your visits go in the calendar. We remind you the week before – nothing to chase.</p></div>
        <div><span class="n">04</span><h3>A note after each visit</h3><p>What we checked, what we fixed and what to watch. It all builds into a record of the house.</p></div>
      </div>
    </div>
  </section>

  <section class="mem-join" id="join">
    <div class="wrap mem-join-grid">
      <div>
        <p class="eyebrow">Request a place</p>
        <h2 class="mem-h2">Let’s put your home on the list.</h2>
        <p class="mem-body">Join online in a couple of minutes, or ask us to call you first – whichever you prefer. Either way, Ilia calls to say hello and book your first visit. If there isn’t room near you this season, we’ll say so plainly, and refund you in full if you’ve paid.</p>
        <p class="mem-body">Rather talk first? Pick a time that suits you – it’s free, and you can show us the house on your phone.</p>
        <p><a class="btn secondary video-call" href={VIDEO_CALL_URL} target="_blank" rel="noopener">Book a free 10-minute video call</a></p>
        <dl class="mem-faq">
          <dt>Can I pause or leave?</dt><dd>After the first twelve months, leave any time with a month’s notice. Leaving sooner? You pay the normal price of the visits you’ve had, less what you’ve paid – and if you’ve paid more, we refund the difference. Moving house? Tell us and we’ll end the plan.</dd>
          <dt>What if something breaks in between?</dt><dd>Members go to the front of the queue, with the discount on your plan.</dd>
          <dt>What’s not included?</dt><dd>Bigger jobs, materials and specialist work are quoted separately, as always – you’ll know the price first.</dd>
        </dl>
      </div>
      <form class="form-card" id="mem-form" novalidate>
        <fieldset class="plan-pick">
          <legend>Plan</legend>
          {PLANS.map((p) => (
            <label><input type="radio" name="plan" value={p.id} checked={p.featured} /><span><strong>{p.name}</strong><em data-month={`£${p.price}/month`} data-year={`${fmt(yearlyPrice(p))}/year`}>£{p.price}/month</em></span></label>
          ))}
        </fieldset>
        <fieldset class="extra-pick" id="extra-pick">
          <legend>Your extra, on us <span class="opt">– Every Season</span></legend>
          {EXTRAS.map((e, i) => (
            <label><input type="radio" name="extra" value={e.id} checked={i === 0} /><span><strong>{e.label}</strong><em>{e.note}</em></span></label>
          ))}
        </fieldset>
        <fieldset class="bill-pick">
          <legend>How you’d like to pay</legend>
          <label><input type="radio" name="billing" value="month" checked /><span><strong>Monthly</strong><em>Spread across the year</em></span></label>
          <label><input type="radio" name="billing" value="year" /><span><strong>Yearly</strong><em>Two months on us</em></span></label>
        </fieldset>
        <div class="field"><label for="mf-name">Full name</label><input id="mf-name" type="text" autocomplete="name" required /></div>
        <div class="field"><label for="mf-email">Email</label><input id="mf-email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="mf-phone">Phone</label><input id="mf-phone" type="tel" autocomplete="tel" required /></div>
        <div class="field"><label for="mf-postcode">Postcode</label><input id="mf-postcode" type="text" autocomplete="postal-code" placeholder="e.g. SW6 1AA" required /></div>
        <div class="field"><label for="mf-notes">About the house <span class="opt">(optional)</span></label><textarea id="mf-notes" placeholder="Flat or house, how many rooms, anything that's bothering you…"></textarea></div>
        <p class="mem-err" id="mf-err" role="alert" hidden></p>
        <div class="mem-actions">
          {PAYMENTS_ENABLED && <button class="btn primary" type="submit" name="action" value="pay" id="mf-pay">Join now – pay securely</button>}
          <button class={`btn ${PAYMENTS_ENABLED ? 'secondary' : 'primary'}`} type="submit" name="action" value="request" id="mf-request">{PAYMENTS_ENABLED ? 'Request a call first' : 'Request a place'}</button>
        </div>
        {PAYMENTS_ENABLED && <p class="mem-paynote" id="mf-paynote">Card, Apple Pay, Google Pay or Direct Debit, secured by Stripe. A twelve-month plan – and if there isn’t room near you, a full refund.</p>}
        <p class="mem-ok" id="mf-ok" role="status" hidden>Thank you – you’re on our list. A person, not a bot, will call you shortly.</p>
      </form>
    </div>
  </section>
</Page>

<style>
  .mem-hero { background: var(--ink); color: var(--cream); padding: clamp(64px, 10vw, 120px) 0 clamp(64px, 9vw, 110px); position: relative; overflow: hidden; }
  .mem-hero::after { content: ''; position: absolute; inset: auto -10% -40% auto; width: 60vw; height: 60vw; border-radius: 50%; background: radial-gradient(circle, rgba(179,68,38,.22), transparent 62%); pointer-events: none; }
  .mem-hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(32px, 6vw, 80px); align-items: center; position: relative; z-index: 1; }
  .mem-eyebrow { margin: 0 0 18px; font: 600 12px/1 var(--font-body); letter-spacing: .22em; text-transform: uppercase; color: #E7DCC6; opacity: .8; }
  .mem-hero h1 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(42px, 6.4vw, 78px); line-height: 1.02; letter-spacing: -.015em; }
  .script { font-family: var(--font-script); font-weight: 400; color: #E9A58E; font-size: 1.15em; letter-spacing: 0; white-space: nowrap; }

  .aside { display: flex; align-items: flex-start; gap: 10px; margin: 14px 0 0; max-width: 34ch; color: #E9A58E; transform: rotate(-1.5deg); transform-origin: left; }
  .aside-arrow { flex: none; width: 46px; height: 32px; margin-top: 2px; opacity: .85; }
  #aside-line { font-family: var(--font-script); font-size: clamp(25px, 2.5vw, 31px); line-height: 1.15; }
  .mem-lede { margin: 24px 0 0; max-width: 52ch; font-size: clamp(17px, 1.6vw, 19px); line-height: 1.6; color: rgba(241,232,216,.78); }
  .mem-cta { display: flex; align-items: center; gap: 24px; margin-top: 34px; flex-wrap: wrap; }
  .mem-btn { display: inline-block; padding: 15px 30px; border-radius: 999px; background: var(--rust); color: var(--cream); font-weight: 600; text-decoration: none; transition: background .15s; }
  .mem-btn:hover { background: var(--brick); }
  .mem-link { color: var(--cream); font-weight: 600; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(241,232,216,.35); }
  .mem-small { margin: 22px 0 0; font-size: 13.5px; letter-spacing: .03em; color: rgba(241,232,216,.55); }

  .mcard-wrap { perspective: 900px; display: flex; justify-content: center; padding: 40px 20px; margin: -40px -20px; }
  .mcard { --gx: 30%; --gy: 20%; --glare: 0; width: min(500px, 118%); flex: none; aspect-ratio: 1.586; border-radius: 28px; padding: 32px 34px; background: linear-gradient(140deg, #F6EEDF 0%, #E9DCC3 100%); color: var(--ink); box-shadow: 0 40px 80px -30px rgba(0,0,0,.6), inset 0 0 0 1px rgba(255,255,255,.5); transform: rotate(-4deg) rotateY(-8deg); transform-style: preserve-3d; will-change: transform; display: flex; flex-direction: column; position: relative; overflow: hidden; touch-action: pan-y; cursor: default; }
  .mcard::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(circle at var(--gx) var(--gy), rgba(255,255,255,.55), rgba(255,255,255,0) 55%); opacity: var(--glare); mix-blend-mode: soft-light; transition: opacity .3s; }
  .mcard::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(115deg, transparent 0 22px, rgba(43,39,35,.025) 22px 23px); }
  .mcard-top { display: flex; justify-content: space-between; align-items: center; position: relative; }
  .mcard-mark { width: 52px; height: 52px; }
  .mcard-kind { font: 600 13px/1 var(--font-body); letter-spacing: .24em; text-transform: uppercase; color: var(--brick); }
  .mcard-script { margin: auto 0 0; font-family: var(--font-script); font-size: 54px; line-height: 1; color: var(--rust); position: relative; }
  .mcard-rows { display: flex; gap: 36px; margin-top: 14px; position: relative; }
  .mcard-rows span { display: block; font-size: 11.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-60); }
  .mcard-rows strong { font-family: var(--font-display); font-weight: 700; font-size: 20px; }
  .mcard-foot { display: flex; justify-content: space-between; margin-top: 18px; padding-top: 12px; border-top: 1px solid var(--ink-12); font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-60); position: relative; }


  .mem-familiar { padding: clamp(64px, 9vw, 112px) 0 0; }
  .fridge { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 4px; max-width: 760px; }
  .fridge li { position: relative; padding-left: 34px; font-family: var(--font-display); font-weight: 700; font-size: clamp(22px, 3vw, 34px); line-height: 1.35; color: var(--ink); transition: color .5s ease; }
  .fridge li::before { content: ''; position: absolute; left: 4px; top: .58em; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--rust); background: transparent; transition: background .4s ease; }
  .fridge li span { position: relative; }
  .fridge li span::after { content: ''; position: absolute; left: -4px; right: -4px; top: 55%; height: 3px; border-radius: 3px; background: var(--rust); transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.6,.1,.2,1); }
  .fridge li.done { color: var(--ink-40); }
  .fridge li.done::before { background: var(--rust); }
  .fridge li.done span::after { transform: scaleX(1); }
  .fridge-after { margin: 26px 0 0; font-size: 18px; color: var(--ink-60); max-width: 52ch; }
  @media (prefers-reduced-motion: reduce) { .fridge li, .fridge li::before, .fridge li span::after { transition: none; } }

  .mem-diff { padding: clamp(64px, 9vw, 112px) 0 0; }
  .diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .diff-col { border-radius: 22px; padding: 30px 30px 26px; }
  .diff-them { background: transparent; border: 1.5px dashed var(--ink-12); }
  .diff-us { background: var(--ink); color: var(--cream); box-shadow: 0 30px 60px -30px rgba(43,39,35,.55); }
  .diff-label { margin: 0 0 16px; font: 600 12px var(--font-body); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-40); }
  .diff-us .diff-label { color: #E9A58E; }
  .diff-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .diff-col li { position: relative; padding-left: 28px; font-size: 16px; line-height: 1.5; }
  .diff-them li { color: var(--ink-60); }
  .diff-them li::before { content: ''; position: absolute; left: 2px; top: .7em; width: 12px; height: 2px; background: var(--ink-40); }
  .diff-us li::before { content: ''; position: absolute; left: 0; top: .32em; width: 14px; height: 8px; border-left: 2px solid #E9A58E; border-bottom: 2px solid #E9A58E; transform: rotate(-45deg); }
  @media (max-width: 760px) { .diff-grid { grid-template-columns: 1fr; } }
  .mem-h2 { margin: 0 0 28px; font-family: var(--font-display); font-weight: 800; font-size: clamp(32px, 4.6vw, 54px); line-height: 1.06; letter-spacing: -.01em; max-width: 18ch; }
  .mem-body { font-size: 17px; line-height: 1.65; color: var(--ink-60); max-width: 48ch; }
  .mem-year, .mem-plans, .mem-check, .mem-how, .mem-join { padding: clamp(64px, 9vw, 112px) 0 0; }
  .mem-join { padding-bottom: clamp(80px, 10vw, 128px); }

  .seg { display: inline-flex; padding: 5px; border-radius: 999px; background: var(--tan-pill); gap: 4px; flex-wrap: wrap; }
  .seg button { border: 0; background: transparent; padding: 10px 18px; border-radius: 999px; font: 600 14px var(--font-body); color: var(--ink-60); cursor: pointer; transition: background .2s, color .2s; }
  .seg button[aria-selected='true'] { background: var(--ink); color: var(--cream); }
  .months { list-style: none; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(12, 1fr); gap: 8px; }
  .months li { background: var(--white); border-radius: 14px; padding: 16px 0 18px; text-align: center; border: 1px solid var(--ink-08); transition: background .3s, border-color .3s; }
  .mname { display: block; font: 600 12px var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-40); }
  .months .dot { display: block; width: 14px; height: 14px; margin: 14px auto 0; border-radius: 50%; border: 1.5px dashed var(--ink-12); transition: transform .35s cubic-bezier(.2,.8,.2,1.4), background .3s, border-color .3s; transform: scale(.8); }
  .months li.check { border-color: rgba(179,68,38,.35); }
  .months li.check .dot { background: var(--rust); border: 0; transform: scale(1); }
  .months li.list .dot { background: var(--sage); border: 0; transform: scale(.85); }
  .months li.check .mname, .months li.list .mname { color: var(--ink); }
  .legend { margin: 18px 0 0; font-size: 14px; color: var(--ink-60); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .lg { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-left: 12px; }
  .lg:first-child { margin-left: 0; }
  .lg.check { background: var(--rust); } .lg.list { background: var(--sage); }

  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch; }
  .plan { background: var(--white); border-radius: 22px; padding: 34px 30px 30px; display: flex; flex-direction: column; border: 1px solid var(--ink-08); position: relative; }
  .plan.is-featured { background: var(--ink); color: var(--cream); border-color: var(--ink); transform: translateY(-10px); box-shadow: 0 30px 60px -30px rgba(43,39,35,.55); }
  .plan-tag { position: absolute; top: -13px; left: 30px; background: var(--rust); color: var(--cream); font: 600 11px/1 var(--font-body); letter-spacing: .16em; text-transform: uppercase; padding: 8px 12px; border-radius: 999px; }
  .plan h3 { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 26px; }
  .plan-cad { margin: 6px 0 0; font-size: 14px; color: var(--ink-60); }
  .is-featured .plan-cad, .is-featured .plan-blurb, .is-featured li { color: rgba(241,232,216,.72); }
  .plan-price { margin: 26px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 56px; line-height: 1; letter-spacing: -.02em; }
  .plan-price .cur { font-size: .5em; vertical-align: .55em; margin-right: 2px; }
  .plan-price .per { font-family: var(--font-body); font-weight: 500; font-size: 15px; letter-spacing: 0; color: var(--ink-40); margin-left: 4px; }
  .is-featured .plan-price .per { color: rgba(241,232,216,.5); }
  .plan-blurb { margin: 16px 0 0; font-size: 15.5px; line-height: 1.55; color: var(--ink-60); min-height: 3.1em; }
  .plan ul { list-style: none; margin: 22px 0 28px; padding: 22px 0 0; border-top: 1px solid var(--ink-12); display: grid; gap: 12px; flex: 1; }
  .is-featured ul { border-color: rgba(241,232,216,.15); }
  .plan li { position: relative; padding-left: 26px; font-size: 15px; line-height: 1.45; }
  .plan li::before { content: ''; position: absolute; left: 0; top: .32em; width: 14px; height: 8px; border-left: 2px solid var(--rust); border-bottom: 2px solid var(--rust); transform: rotate(-45deg); }
  .is-featured li::before { border-color: #E9A58E; }
  .plan-btn { display: block; text-align: center; padding: 14px 18px; border-radius: 999px; border: 1.5px solid var(--ink); color: var(--ink); font-weight: 600; text-decoration: none; transition: background .15s, color .15s; }
  .plan-btn:hover { background: var(--ink); color: var(--cream); }
  .plan-btn.solid { background: var(--rust); border-color: var(--rust); color: var(--cream); }
  .plan-btn.solid:hover { background: var(--brick); border-color: var(--brick); }
  .mem-note { margin: 28px 0 0; font-size: 14px; color: var(--ink-60); }

  .mem-check-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .checklist { list-style: none; margin: 0; padding: 30px 32px; background: var(--white); border-radius: 22px; columns: 2; column-gap: 28px; }
  .checklist li { break-inside: avoid; padding: 11px 0 11px 30px; position: relative; font-size: 15.5px; line-height: 1.4; border-bottom: 1px dotted var(--ink-12); counter-increment: chk; }
  .checklist { counter-reset: chk; }
  .checklist li::before { content: counter(chk, decimal-leading-zero); position: absolute; left: 0; top: 13px; font: 600 11px var(--font-body); color: var(--rust); letter-spacing: .04em; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 8px; }
  .steps > div { border-top: 2px solid var(--ink); padding-top: 18px; }
  .steps .n { font: 600 12px var(--font-body); letter-spacing: .14em; color: var(--rust); }
  .steps h3 { margin: 10px 0 8px; font-family: var(--font-display); font-weight: 700; font-size: 20px; }
  .steps p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-60); }

  .mem-join-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .mem-faq { margin: 32px 0 0; }
  .mem-faq dt { font-family: var(--font-display); font-weight: 700; font-size: 18px; margin-top: 22px; }
  .mem-faq dd { margin: 6px 0 0; font-size: 15.5px; line-height: 1.6; color: var(--ink-60); }
  .billing { display: inline-flex; gap: 4px; margin: 28px 0 36px; padding: 5px; border-radius: 999px; background: var(--white); border: 1px solid var(--ink-08); }
  .billing button { border: 0; background: transparent; padding: 11px 20px; border-radius: 999px; font: 600 15px/1 var(--font-body); color: var(--ink-60); cursor: pointer; display: inline-flex; align-items: center; gap: 10px; transition: background .2s, color .2s; }
  .billing button[aria-checked="true"] { background: var(--ink); color: var(--cream); }
  .billing-gift { font-family: var(--font-script); font-weight: 400; font-size: 21px; line-height: .8; color: var(--rust); }
  .billing button[aria-checked="true"] .billing-gift { color: #E9A58E; }
  .plans[data-billing-view="month"] .only-year, .plans[data-billing-view="year"] .only-month { display: none; }
  .plan-save { margin: 8px 0 0; font-size: 13.5px; color: var(--rust); }
  .plan-save s { color: var(--ink-40); margin-right: 2px; }
  .is-featured .plan-save { color: #E9A58E; }
  .is-featured .plan-save s { color: rgba(241,232,216,.5); }
  .plan-worth { margin: 10px 0 0; font-size: 13.5px; color: var(--ink-60); font-style: italic; }
  .is-featured .plan-worth { color: rgba(241,232,216,.65); }
  .plan-extra { margin: 18px 0 20px; padding: 14px 16px; border-radius: 14px; border: 1px dashed rgba(233,165,142,.55); }
  .plan-extra-h { margin: 0; font-family: var(--font-script); font-size: 24px; line-height: 1.1; color: #E9A58E; }
  .plan-extra-list { margin: 6px 0 0; font-size: 14px; color: rgba(241,232,216,.8); }
  .extra-pick { border: 0; margin: 0 0 22px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .extra-pick[hidden] { display: none; }
  .extra-pick legend { font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .extra-pick .opt { font-weight: 400; color: var(--ink-60); }
  .extra-pick label { display: grid; gap: 8px; align-content: start; padding: 14px; border: 1.5px solid var(--ink-12); border-radius: 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .extra-pick label:has(input:checked) { border-color: var(--rust); background: var(--rust-tint); }
  .extra-pick input { accent-color: var(--rust); margin: 0; }
  .extra-pick span { display: grid; gap: 2px; font-size: 14px; line-height: 1.3; }
  .extra-pick em { font-style: normal; color: var(--ink-60); font-size: 12.5px; }
  @media (max-width: 520px) { .extra-pick { grid-template-columns: 1fr; } .extra-pick label { grid-template-columns: auto 1fr; align-items: center; } }
  .bill-pick { border: 0; margin: 0 0 22px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .bill-pick legend { font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .bill-pick label { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px solid var(--ink-12); border-radius: 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .bill-pick label:has(input:checked) { border-color: var(--rust); background: var(--rust-tint); }
  .bill-pick input { accent-color: var(--rust); }
  .bill-pick span { display: grid; gap: 2px; }
  .bill-pick em { font-style: normal; color: var(--ink-60); font-size: 13px; }
  .plan-pick { border: 0; margin: 0 0 22px; padding: 0; display: grid; gap: 10px; }
  .plan-pick legend { font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .plan-pick label { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px solid var(--ink-12); border-radius: 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .plan-pick label:has(input:checked) { border-color: var(--rust); background: var(--rust-tint); }
  .plan-pick input { accent-color: var(--rust); }
  .plan-pick span { display: flex; justify-content: space-between; flex: 1; gap: 12px; }
  .plan-pick em { font-style: normal; color: var(--ink-60); font-size: 14px; }
  .opt { font-weight: 400; color: var(--ink-40); }
  .mem-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .mem-actions .btn { flex: 1 1 auto; justify-content: center; }
  .mem-actions .btn[hidden] { display: none; }
  .mem-actions .btn[disabled] { opacity: .6; cursor: progress; }
  .mem-paynote { margin: 14px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--ink-60); }
  .mem-paynote.is-far { color: var(--ink); background: var(--sand, #EFE5D3); padding: 12px 14px; border-radius: 12px; }
  .mem-err { margin: 0 0 14px; color: var(--brick); font-size: 14.5px; }
  .mem-ok { margin: 16px 0 0; padding: 14px 16px; border-radius: 12px; background: var(--sage-tint); font-size: 15px; }

  @media (max-width: 900px) {
    .mem-hero-grid, .mem-check-grid, .mem-join-grid { grid-template-columns: 1fr; }
    .mcard-wrap { margin-top: 12px; }
    .mcard { width: min(500px, 100%); }
    .plans { grid-template-columns: 1fr; max-width: 460px; }
    .plan.is-featured { transform: none; margin-top: 12px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .months { grid-template-columns: repeat(6, 1fr); }
  }
  @media (max-width: 560px) {
    .checklist { columns: 1; padding: 22px; }
    .steps { grid-template-columns: 1fr; }
    .months { grid-template-columns: repeat(4, 1fr); }
    .seg button { padding: 9px 13px; font-size: 13px; }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabase-config';
  import { PLANS, EXTRAS } from '../../data/membership';
  import { ONLINE_JOIN_MAX_MILES } from '../../data/payments';
  import { lookupCoords, milesFromBase } from '../../data/travel';


  // "Sound familiar?" – each line is crossed off as it scrolls up past the middle of the screen,
  // and un-crossed again when you scroll back up.
  const fridgeItems = Array.from(document.querySelectorAll<HTMLLIElement>('#fridge li'));
  if (fridgeItems.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.55;
      for (const li of fridgeItems) {
        const r = li.getBoundingClientRect();
        li.classList.toggle('done', r.top + r.height / 2 < line);
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }


  // Playful one-liners under the hero – a different one each time you come back to the page.
  const ASIDES = [
    'Like a streaming subscription – except each season’s new episode is your gutters, cleared.',
    'Auto-renewing peace of mind. No buffering.',
    'Think of it as a service plan for your car – only the car is your house.',
    'Your home, on repeat – in the good way.',
    'A box set of seasons, each one ending with your list ticked off.',
    'Like a magazine subscription – except we turn up instead of the post.',
  ];
  const asideEl = document.getElementById('aside-line');
  if (asideEl) {
    const KEY = 'fettle-aside';
    const pickNew = () => {
      let last = -1;
      try { last = Number(localStorage.getItem(KEY) ?? -1); } catch {}
      let i = Math.floor(Math.random() * (ASIDES.length - 1));
      if (i >= last && last >= 0) i += 1; // never the same line twice in a row
      try { localStorage.setItem(KEY, String(i)); } catch {}
      asideEl.textContent = ASIDES[i];
    };
    pickNew();
    // Coming back to the tab, or returning with the back button, shows a fresh line.
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') pickNew(); });
    window.addEventListener('pageshow', (e) => { if ((e as PageTransitionEvent).persisted) pickNew(); });
  }

  const monthEls = Array.from(document.querySelectorAll<HTMLLIElement>('#months li'));
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg button'));
  const cardPlan = document.getElementById('mcard-plan');
  const cardVisits = document.getElementById('mcard-visits');

  function show(id: string) {
    const plan = PLANS.find((p) => p.id === id);
    if (!plan) return;
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.plan === id)));
    monthEls.forEach((li, i) => {
      li.classList.remove('check', 'list');
      const v = plan.visits.find((x) => x.month === i);
      if (v) setTimeout(() => li.classList.add(v.kind), i * 35);
    });
    if (cardPlan) cardPlan.textContent = plan.name;
    if (cardVisits) cardVisits.textContent = plan.cadence;
    const radio = document.querySelector<HTMLInputElement>(`input[name="plan"][value="${id}"]`);
    if (radio) radio.checked = true;
    const extraPick = document.getElementById('extra-pick');
    if (extraPick) extraPick.hidden = !plan.choosesExtra;
  }
  tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.plan!)));
  document.querySelectorAll<HTMLAnchorElement>('[data-choose]').forEach((a) =>
    a.addEventListener('click', () => show(a.dataset.choose!)),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="plan"]').forEach((r) =>
    r.addEventListener('change', () => show(r.value)),
  );
  show((PLANS.find((p) => p.featured) ?? PLANS[0]).id);

  // Monthly or yearly – the switch above the plans and the choice in the form stay in step.
  const plansEl = document.querySelector<HTMLElement>('.plans[data-billing-view]');
  const billBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-billing]'));
  function setBilling(b: 'month' | 'year') {
    plansEl?.setAttribute('data-billing-view', b);
    billBtns.forEach((x) => x.setAttribute('aria-checked', String(x.dataset.billing === b)));
    const r = document.querySelector<HTMLInputElement>(`input[name="billing"][value="${b}"]`);
    if (r) r.checked = true;
    document.querySelectorAll<HTMLElement>('.plan-pick em[data-month]').forEach((em) => { em.textContent = em.dataset[b] ?? ''; });
  }
  billBtns.forEach((x) => x.addEventListener('click', () => setBilling(x.dataset.billing as 'month' | 'year')));
  document.querySelectorAll<HTMLInputElement>('input[name="billing"]').forEach((r) =>
    r.addEventListener('change', () => setBilling(r.value as 'month' | 'year')),
  );

  // Membership card: the corner under the cursor is pressed into the page.
  const card = document.querySelector<HTMLElement>('.mcard');
  const zone = document.querySelector<HTMLElement>('.mcard-wrap');
  if (card && zone && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const MAX = 16; // degrees of tilt at the very corner
    const rest = { rz: -4, rx: 0, ry: -8, s: 1 };
    const cur = { ...rest };
    let target = { ...rest };
    let raf = 0;
    const apply = () => {
      const k = 0.14; // easing – lower is softer
      let moving = false;
      for (const key of ['rz', 'rx', 'ry', 's'] as const) {
        const d = target[key] - cur[key];
        if (Math.abs(d) > 0.001) { cur[key] += d * k; moving = true; } else cur[key] = target[key];
      }
      card.style.transform = `rotate(${cur.rz}deg) rotateX(${cur.rx}deg) rotateY(${cur.ry}deg) scale(${cur.s})`;
      raf = moving ? requestAnimationFrame(apply) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(apply); };
    zone.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const r = card.getBoundingClientRect();
      const x = Math.max(-0.5, Math.min(0.5, (e.clientX - r.left) / r.width - 0.5));
      const y = Math.max(-0.5, Math.min(0.5, (e.clientY - r.top) / r.height - 0.5));
      // Cursor right → right edge goes back (rotateY +). Cursor top → top edge goes back (rotateX +).
      target = { rz: 0, rx: -y * 2 * MAX, ry: x * 2 * MAX, s: 1.03 };
      card.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
      card.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
      card.style.setProperty('--glare', '1');
      kick();
    });
    zone.addEventListener('pointerleave', () => {
      target = { ...rest };
      card.style.setProperty('--glare', '0');
      kick();
    });
  }

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {
    auth: { persistSession: false },
  });
  const form = document.getElementById('mem-form') as HTMLFormElement | null;
  const err = document.getElementById('mf-err');
  const ok = document.getElementById('mf-ok');
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  // "Join now" is offered close to Chelsea; further out we'd rather talk first.
  const payBtn = document.getElementById('mf-pay') as HTMLButtonElement | null;
  const reqBtn = document.getElementById('mf-request') as HTMLButtonElement | null;
  const payNote = document.getElementById('mf-paynote');
  const payNoteDefault = payNote?.textContent ?? '';
  const setFar = (far: boolean, area = '') => {
    if (!payBtn || !reqBtn || !payNote) return;
    payBtn.hidden = far;
    reqBtn.className = `btn ${far ? 'primary' : 'secondary'}`;
    reqBtn.textContent = far ? 'Request a place' : 'Request a call first';
    payNote.classList.toggle('is-far', far);
    payNote.textContent = far
      ? `${area || 'Your area'} is a little further from us, so we’d like to talk first. Request a place and Ilia will call you – usually the same day.`
      : payNoteDefault;
  };
  let pcTimer = 0;
  const pcInput = document.getElementById('mf-postcode') as HTMLInputElement | null;
  const checkPostcode = async () => {
    const pc = pcInput?.value.trim().toUpperCase() ?? '';
    if (!/^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/.test(pc)) return setFar(false);
    const c = await lookupCoords(pc);
    if (c) setFar(milesFromBase(c.lat, c.lon) > ONLINE_JOIN_MAX_MILES, pc.replace(/\s*\d[A-Z]{2}$/, ''));
  };
  pcInput?.addEventListener('input', () => { clearTimeout(pcTimer); pcTimer = window.setTimeout(checkPostcode, 450); });

  if (new URLSearchParams(location.search).get('checkout') === 'cancelled' && err) {
    err.textContent = 'No payment was taken. Change anything you like and try again – or ask us to call you first.';
    err.hidden = false;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (err) err.hidden = true;
    const action = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value ?? 'request';
    const name = val('mf-name'), email = val('mf-email'), phone = val('mf-phone'), postcode = val('mf-postcode').toUpperCase();
    const notes = (document.getElementById('mf-notes') as HTMLTextAreaElement).value.trim();
    const planId = (form.querySelector('input[name="plan"]:checked') as HTMLInputElement | null)?.value;
    const plan = PLANS.find((p) => p.id === planId);
    const billing = (form.querySelector('input[name="billing"]:checked') as HTMLInputElement | null)?.value === 'year' ? 'year' : 'month';
    const extra = plan?.choosesExtra ? EXTRAS.find((x) => x.id === (form.querySelector('input[name="extra"]:checked') as HTMLInputElement | null)?.value) : undefined;
    const priceLabel = billing === 'year' ? `£${(plan!.price * 10).toLocaleString('en-GB')}/year` : `£${plan?.price}/month`;
    const problems: string[] = [];
    if (!name) problems.push('your name');
    if (!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(email)) problems.push('a valid email');
    if (!/^[+0-9 ()-]{7,}$/.test(phone)) problems.push('a phone number');
    if (!/^[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}$/.test(postcode)) problems.push('your full postcode');
    if (problems.length) {
      if (err) { err.textContent = `Nearly there – we just need ${problems.join(', ')}.`; err.hidden = false; }
      return;
    }
    if (action === 'pay' && payBtn && !payBtn.hidden) {
      payBtn.disabled = true;
      const label = payBtn.textContent;
      payBtn.textContent = 'Opening secure payment…';
      try {
        const res = await fetch(`${SUPABASE_URL}/functions/v1/membership-checkout`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
          body: JSON.stringify({ plan: plan?.id, billing, extra: extra?.id, name, email, phone, postcode, notes }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.url) {
          window.dispatchEvent(new CustomEvent('fettle:lead', { detail: { kind: `membership checkout – ${plan?.name}` } }));
          location.href = data.url;
          return;
        }
        if (data.error === 'far') setFar(true, postcode.replace(/\s*\d[A-Z]{2}$/, ''));
        else if (err) { err.textContent = data.error || 'The payment page didn’t open. Please try again, or ask us to call you first.'; err.hidden = false; }
      } catch {
        if (err) { err.textContent = 'The payment page didn’t open. Please try again, or ask us to call you first.'; err.hidden = false; }
      }
      payBtn.disabled = false;
      payBtn.textContent = label;
      return;
    }
    const btn = reqBtn ?? (form.querySelector('button[type="submit"]') as HTMLButtonElement);
    btn.disabled = true;
    const { error } = await supabase.from('contact_submissions').insert({
      full_name: name,
      email,
      postcode,
      topic: `Membership request – ${plan?.name} (${priceLabel})${extra ? ` – extra: ${extra.label}` : ''}`,
      message: [`Phone: ${phone}`, notes].filter(Boolean).join('\n\n'),
    });
    btn.disabled = false;
    if (error) {
      if (err) { err.textContent = 'Sorry, that didn’t send. Please try again, or call 07361 854124.'; err.hidden = false; }
      return;
    }
    form.reset();
    show(plan!.id);
    setBilling(billing);
    if (ok) ok.hidden = false;
    window.dispatchEvent(new CustomEvent('fettle:lead', { detail: { kind: `membership – ${plan?.name}` } }));
  });
</script>
