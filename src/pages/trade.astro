---
import Page from '../layouts/Page.astro';
import CoverageMap from '../components/CoverageMap.astro';

const groups = [
  {
    title: 'Letting agents & property managers',
    offer: 'A free ready-to-let check',
    body: 'We go through the next property you have between tenants, send photos and fixed prices the same day, and fix anything that takes under an hour there and then, free.',
    jobs: 'Sticking doors and windows, dripping taps, tired sealant, scuffed walls before photos and viewings, loose handrails and shelves.',
  },
  {
    title: 'Block managers',
    offer: 'A free block walk-round',
    body: 'We walk the communal areas of one of your blocks and send photos with a fixed-price list of small works the same day – useful for your next update to residents, whether or not you book us.',
    jobs: 'Communal decorating, door closers and latches, letterplates, dead fittings and timers in halls and stairwells, damp, cracks and sealant.',
  },
  {
    title: 'Short-let hosts & serviced apartments',
    offer: 'A free guest-ready check',
    body: 'We go through one of your homes and send photos and fixed prices the same day. Anything under an hour we fix on the spot, free, and we work between check-out and check-in.',
    jobs: 'Showers and taps, blinds and curtain poles, handles and locks, marks on walls before the next listing photos.',
  },
  {
    title: 'Offices & workspaces',
    offer: 'A free 30-minute walk-round',
    body: 'We walk your building with you and leave a written list of the small fixes we spot, each with a fixed price – yours to keep whether or not you ever book us.',
    jobs: 'Door closers, blinds, lights and sockets (by our certified electrician), scuffed corridors and meeting rooms, kitchens and washrooms.',
  },
];

const terms = [
  ['Half price on your first job', 'After the free check, the first job you book with us is half price. The same goes for anyone you send our way.'],
  ['Fixed prices, agreed first', 'Every job is priced before we start. No day rates that drift, no surprises on the invoice.'],
  ['Photos before and after', 'Every job comes with photos, so you can show landlords, residents or your team without driving over to check.'],
  ['One monthly invoice', 'If it is easier for your accounts, we bill everything once a month.'],
  ['No minimum for agents', 'A single tap washer is fine. Small jobs are the point.'],
  ['Next day, 7am to 9pm', 'Small fixes are booked in the same or next working day. We work 7am to 9pm, seven days, so offices and occupied buildings aren’t disturbed.'],
];

const plans = [
  { name: 'Monthly', price: 149, line: 'One 3-hour visit a month', fit: 'Small offices and single floors' },
  { name: 'Fortnightly', price: 279, line: 'A 3-hour visit every two weeks', fit: 'Busy offices and coworking floors' },
  { name: 'Weekly', price: 499, line: 'A 3-hour visit every week', fit: 'Business centres and multi-floor buildings' },
];
const perks = [
  'Same or next working day call-outs between visits',
  'Extra work at 10% off',
  'A photo report after every visit',
  'One monthly invoice',
];
const paperwork = [
  ['Insurance', '£5m public liability insurance – certificate sent on request.'],
  ['RAMS', 'Risk assessments and method statements for the work we do, ready before we start.'],
  ['Electrical certificates', 'Lights and sockets by our certified electrician, with the paperwork to match.'],
];
const moves = 'Shelving, screens and whiteboards, TV and monitor mounting, making good after old fittings come out, and decorating between tenants.';
const notDo = 'Gas work, full office fit-outs, roofing and large building projects. If you need one of those, we will tell you straight away rather than take it on.';
---

<Page title="Fettle for Agents, Landlords & Offices – Small Works in London" description="A small permanent maintenance team for letting agents, block managers, short-let hosts and offices in London. Free check or walk-round, fixed prices, photos before and after, half price on your first job.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Fettle for business</p>
      <h1>The small jobs between tenants, guests and Monday mornings – sorted.</h1>
      <p class="lede">A small permanent team based on Fulham Road in Chelsea, looking after London properties since 2023. We work for letting agents, block managers, short-let hosts and offices: fully insured, the same faces each visit, and no travel charge.</p>
      <div class="badge-row" style="margin-top:20px">
        <span class="pill"><span class="dot"></span>Free check or walk-round</span>
        <span class="pill"><span class="dot"></span>Fixed prices</span>
        <span class="pill"><span class="dot"></span>Photos with every job</span>
        <span class="pill"><span class="dot"></span>Half price first job</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <h2 class="prose" style="margin-top:0">Start with something free</h2>
      <p class="prose" style="color:var(--ink-60); margin-top:-8px">Pick the one that fits. No catch and no obligation – you keep the list either way.</p>
      <div class="grid two" style="margin-top:24px">
        {groups.map((g) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:6px">{g.title}</p>
            <h3>{g.offer}</h3>
            <p>{g.body}</p>
            <p style="color:var(--ink-60); font-size:0.95em"><strong>Typical jobs:</strong> {g.jobs}</p>
          </div>
        ))}
      </div>

      <hr class="divider" />

      <h2 class="prose" style="margin-top:0">How we work with businesses</h2>
      <div class="grid three" style="margin-top:20px">
        {terms.map(([h, p]) => (
          <div class="card">
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>

      <hr class="divider" />

      <p class="eyebrow">For offices &amp; workspaces</p>
      <h2 class="prose" style="margin-top:0">Office maintenance plans</h2>
      <p class="prose" style="color:var(--ink-60); margin-top:-8px">A regular visit from the same small team, who work through your list of small fixes before anyone has to report them. Paid monthly.</p>
      <div class="grid three" style="margin-top:20px">
        {plans.map((p) => (
          <div class="card">
            <p class="eyebrow" style="margin-bottom:6px">{p.name}</p>
            <h3 style="font-size:2rem; margin:0">&pound;{p.price}<span style="font-size:1rem; font-weight:500; color:var(--ink-60)"> a month</span></h3>
            <p><strong>{p.line}</strong></p>
            <p style="color:var(--ink-60)">{p.fit}</p>
          </div>
        ))}
      </div>
      <div class="badge-row" style="margin-top:18px">
        {perks.map((x) => <span class="pill"><span class="dot"></span>{x}</span>)}
      </div>

      <div class="grid two" style="margin-top:28px">
        <div class="card">
          <h3>Moving in, moving out</h3>
          <p>{moves}</p>
        </div>
        <div class="card">
          <h3>What we don’t do</h3>
          <p>{notDo}</p>
        </div>
      </div>

      <h2 class="prose" style="margin-top:36px">Paperwork, ready when you need it</h2>
      <div class="grid three" style="margin-top:16px">
        {paperwork.map(([h, p]) => (
          <div class="card">
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>

      <hr class="divider" />

      <div class="prose">
        <h2>See if we work around your office</h2>
        <p>Our base is in Chelsea, and one of the team lives in Wimbledon, so Chelsea, Fulham, Kensington, Battersea, Clapham, Putney, Wandsworth and Wimbledon are home turf. We cover most of London. Type your office or building postcode to check.</p>
      </div>
      <div style="margin-top:20px">
        <CoverageMap id="cov-trade" label="See if we work around your office" />
      </div>

      <hr class="divider" />

      <div class="prose">
        <h2>Book the free check</h2>
        <p>Tell us the address and a day that suits. Call or WhatsApp <a href="tel:+447361854124">07361 854124</a>, email <a href="mailto:hello@fettlelondon.com">hello@fettlelondon.com</a>, or use the contact form.</p>
        <p><a class="btn primary" href="/contact">Book a free check</a></p>
      </div>
    </div>
  </section>
</Page>
