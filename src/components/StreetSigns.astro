---
// The floating street sign for a page, beside the heading (on the homepage, on the wall in
// the hero photo). It tilts toward the cursor like the membership card and drifts as you scroll.
import StreetSign from './StreetSign.astro';
import { signsFor } from '../data/signs';
import '../styles/signs.css';

interface Props { path?: string }
const signs = signsFor(Astro.props.path ?? Astro.url.pathname);
const hero = signs[0];
---

{hero && (
  <div class="sign-float sign-hero is-waiting" data-sign="hero" data-rot="-4" data-depth="0.35">
    <span class="ss-shadow" aria-hidden="true"></span>
    <StreetSign sign={hero} />
  </div>
)}
<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Put the sign beside the page heading (or on the wall in the home hero).
  const wrap = document.querySelector<HTMLElement>('[data-sign="hero"]');
  const spot = matchMedia('(max-width: 980px)').matches ? document.querySelector<HTMLElement>('.page-hero .wrap') : document.querySelector<HTMLElement>('.page-hero');
  if (wrap && spot) {
    spot.appendChild(wrap);
    document.body.classList.add('has-hero-sign');
  } else wrap?.remove();

  const card = wrap?.querySelector<HTMLElement>('.ss');
  if (wrap && card) {
    // 1. Arrive: slide in from the side and expand, once it's on screen.
    const arrive = () => { wrap.classList.remove('is-waiting'); wrap.classList.add('is-in'); };
    if (reduce) arrive();
    else {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(arrive, 120); } }, { threshold: 0.2 });
      io.observe(wrap);
    }

    // 2. Then the membership card's behaviour: at rest it leans a little; under the cursor,
    //    the corner nearest you is pressed into the page, with a soft glare.
    if (!reduce) {
      const MAX = 16;
      const rest = { rz: -4, rx: 0, ry: -8, s: 1 };
      const cur = { ...rest };
      let target = { ...rest };
      let raf = 0;
      const apply = () => {
        let moving = false;
        for (const k of ['rz', 'rx', 'ry', 's'] as const) {
          const d = target[k] - cur[k];
          if (Math.abs(d) > 0.001) { cur[k] += d * 0.14; moving = true; } else cur[k] = target[k];
        }
        const st = wrap.style;
        st.setProperty('--rz', `${cur.rz.toFixed(2)}deg`); st.setProperty('--rx', `${cur.rx.toFixed(2)}deg`);
        st.setProperty('--ry', `${cur.ry.toFixed(2)}deg`); st.setProperty('--sc', cur.s.toFixed(3));
        // Shadow: light from the top left. The edge that lifts throws its shadow further out.
        const lift = (cur.s - 1) / 0.03; // 0 at rest, 1 when pressed
        st.setProperty('--sx', `${(10 - cur.ry * 0.9).toFixed(1)}px`);
        st.setProperty('--sy', `${(20 + cur.rx * 0.9 + lift * 8).toFixed(1)}px`);
        st.setProperty('--sb', `${(16 + lift * 10).toFixed(1)}px`);
        st.setProperty('--so', (0.85 - lift * 0.2).toFixed(2));
        st.setProperty('--ss', (0.96 - lift * 0.02).toFixed(3));
        raf = moving ? requestAnimationFrame(apply) : 0;
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(apply); };
      kick();
      wrap.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'touch') return;
        const r = card.getBoundingClientRect();
        const x = Math.max(-0.5, Math.min(0.5, (e.clientX - r.left) / r.width - 0.5));
        const y = Math.max(-0.5, Math.min(0.5, (e.clientY - r.top) / r.height - 0.5));
        target = { rz: 0, rx: -y * 2 * MAX, ry: x * 2 * MAX, s: 1.03 };
        wrap.style.setProperty('--gx', `${(x + 0.5) * 100}%`);
        wrap.style.setProperty('--gy', `${(y + 0.5) * 100}%`);
        wrap.style.setProperty('--glare', '1');
        kick();
      });
      wrap.addEventListener('pointerleave', () => {
        target = { ...rest };
        wrap.style.setProperty('--glare', '0');
        kick();
      });
      // Phones: no cursor, so it sways gently as the page scrolls.
      if (!matchMedia('(hover: hover)').matches) {
        let last = scrollY;
        addEventListener('scroll', () => {
          const dy = scrollY - last; last = scrollY;
          target = { ...rest, rz: rest.rz + Math.max(-6, Math.min(6, dy * 0.4)), rx: Math.max(-8, Math.min(8, dy * 0.5)) };
          kick();
          clearTimeout((wrap as any)._t);
          (wrap as any)._t = setTimeout(() => { target = { ...rest }; kick(); }, 140);
        }, { passive: true });
      }
    }
  }
</script>
