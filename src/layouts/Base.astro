---
import '../styles/ds.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A small London team, keeping a short list of homes in good working order. By recommendation, mostly.' } = Astro.props;
// One canonical home: https://www.fettlelondon.com, no trailing slash (except the root).
const path = Astro.url.pathname.replace(/\/index(\.html)?$/, '/').replace(/\.html$/, '').replace(/(.)\/+$/, '$1');
const canonical = new URL(path, Astro.site ?? 'https://www.fettlelondon.com').href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HandymanService",
      "name": "Fettle",
      "description": "A small permanent team keeping a short list of London homes in good working order.",
      "url": "https://www.fettlelondon.com",
      "foundingDate": "2023",
      "telephone": "+447361854124",
      "priceRange": "\u00a330\u2013\u00a3260",
      "areaServed": [
        "North London",
        "Northwest London",
        "West London",
        "Southwest London",
        "South London",
        "Central London"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "London",
        "addressCountry": "GB"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "18:00"
      }
    })} />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
