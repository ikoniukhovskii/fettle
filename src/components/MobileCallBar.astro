---
// Sticky Call / WhatsApp bar for phones. Hidden on larger screens.
---
<nav class="fcall" aria-label="Call or WhatsApp Fettle">
  <a class="fcall-btn fcall-call" href="tel:+447361854124">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
    Call
  </a>
  <a class="fcall-btn fcall-wa" href="https://wa.me/447361854124?text=Hi%20Fettle%2C%20" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
    WhatsApp
  </a>
</nav>
<style is:global>
  .fcall { display: none; }
  @media (max-width: 720px) {
    .fcall {
      display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 69;
      padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: rgba(241, 232, 216, .96); backdrop-filter: blur(8px);
      box-shadow: 0 -6px 20px rgba(43, 39, 35, .14);
    }
    .fcall-btn {
      display: flex; align-items: center; justify-content: center; gap: 8px; height: 50px;
      border-radius: 25px; font: 600 16px/1 var(--font-body, 'Work Sans', sans-serif); text-decoration: none;
    }
    .fcall-btn svg { width: 20px; height: 20px; }
    .fcall-call { background: var(--rust, #B34426); color: var(--cream, #F1E8D8); }
    .fcall-wa { background: var(--ink, #2B2723); color: var(--cream, #F1E8D8); }
    body { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }
    /* keep the chat bubble above the bar */
    .fchat-launcher { bottom: calc(82px + env(safe-area-inset-bottom)) !important; }
    .fchat.is-open ~ .fcall, body:has(.fchat.is-open) .fcall { display: none; }
  }
</style>
