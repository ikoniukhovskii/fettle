---
/* Shared chrome for the content pages. Replaces design-export/pages/chrome.js,
   which injected this markup with innerHTML after load. */
import Base from './Base.astro';
import { SERVICES } from '../data/services';
import { SOCIALS } from '../data/schema';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { label: 'What we fix', href: '/services' },
  { label: 'How it works', href: '/how-it-works' },
  { label: 'About', href: '/about' },
];

const footerCols = [
  {
    heading: 'Services',
    links: [
      { label: 'What we fix', href: '/services' },
      ...SERVICES.slice(0, 5).map((s) => ({ label: s.name, href: `/services/${s.slug}` })),
    ],
  },
  {
    heading: 'More services',
    links: [
      ...SERVICES.slice(5).map((s) => ({ label: s.name, href: `/services/${s.slug}` })),
      { label: 'How it works', href: '/how-it-works' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { label: 'About Fettle', href: '/about' },
      { label: 'Membership', href: '/membership' },
      { label: 'Testimonials', href: '/testimonials' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy' },
      { label: 'Terms of use', href: '/terms' },
      { label: 'Cookies', href: '/cookies' },
    ],
  },
];
---

<Base title={title} description={description} noindex={noindex}>
  <slot name="head" slot="head" />
  <header class="site-header">
    <div class="wrap">
      <div class="bar">
        <a class="brand" href="/">Fettle</a>
        <nav aria-label="Primary">
          {nav.map((l) => (
            <a class="hide-sm" href={l.href} aria-current={path === l.href ? 'page' : undefined}>
              {l.label}
            </a>
          ))}
          <a class="mem" href="/membership" aria-current={path === '/membership' ? 'page' : undefined}><span aria-hidden="true">✦</span>Membership</a>
          <a class="cta" href="/contact">Contact</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="foot-inner">
      <div class="foot-top">
        <div class="foot-brand">
          <a class="foot-logo" href="/">Fettle</a>
          <p class="foot-tag">London home care with efficiency, transparency and a tidy finish. Since 2023.</p>
        </div>
        {footerCols.map((col) => (
          <div class="foot-col">
            <h4>{col.heading}</h4>
            {col.links.map((l) => (
              <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
            ))}
          </div>
        ))}
      </div>
      <div class="foot-bottom">
        <span class="copy">&copy; {new Date().getFullYear()} Fettle London. All rights reserved.</span>
        <div class="foot-social">
          {SOCIALS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={`Fettle London on ${s.label}`}>{s.label}</a>
          ))}
        </div>
      </div>
    </div>
    <button class="foot-totop" type="button" aria-label="Back to top">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path>
      </svg>
    </button>
  </footer>

  <script>
    /* Header: a full-width bar at the top of the page; on scroll it eases into a rounded
       white pill, exactly like the homepage header (same easing, speed and shadow).
       The header's height never changes, so nothing on the page jumps. */
    (() => {
      const header = document.querySelector<HTMLElement>('.site-header');
      const bar = header?.querySelector<HTMLElement>('.bar');
      if (!header || !bar) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lerp = (a: number, b: number, p: number) => a + (b - a) * p;
      const easeOut = (p: number) => 1 - Math.pow(1 - p, 3);
      let cur = 0, target = 0, raf = 0, full = 0, pill = 0;
      const measure = () => {
        full = (header.querySelector('.wrap') as HTMLElement).clientWidth;
        // Pill hugs the logo + links, never wider than the page column.
        const natural = bar.querySelector<HTMLElement>('.brand')!.offsetWidth + bar.querySelector<HTMLElement>('nav')!.scrollWidth + 56 + 44;
        pill = Math.min(full, Math.max(natural, Math.min(920, window.innerWidth - 28)));
      };
      const apply = (raw: number) => {
        const p = easeOut(raw);
        bar.style.maxWidth = `${lerp(full, pill, p)}px`;
        bar.style.margin = '0 auto';
        header.style.paddingTop = `${lerp(0, 12, p)}px`;
        bar.style.padding = `${lerp(18, 12, p)}px ${lerp(0, 22, p)}px`;
        bar.style.borderRadius = `${lerp(0, 20, p)}px`;
        bar.style.background = `rgba(255,255,255,${p.toFixed(3)})`;
        bar.style.boxShadow = `0 8px 24px rgba(43,39,35,${(0.1 * p).toFixed(3)}), 0 2px 6px rgba(43,39,35,${(0.06 * p).toFixed(3)})`;
        header.style.background = `rgba(241,232,216,${(0.86 * (1 - p)).toFixed(3)})`;
        header.style.borderBottomColor = `rgba(43,39,35,${(0.12 * (1 - p)).toFixed(3)})`;
      };
      const tick = () => {
        cur += (target - cur) * 0.16;
        if (Math.abs(cur - target) <= 0.001) cur = target;
        apply(cur);
        raf = cur === target ? 0 : requestAnimationFrame(tick);
      };
      const onScroll = () => {
        const t = window.scrollY > 60 ? 1 : 0;
        if (t === target) return;
        target = t;
        if (reduce) { cur = t; apply(cur); return; }
        if (!raf) raf = requestAnimationFrame(tick);
      };
      measure();
      target = cur = window.scrollY > 60 ? 1 : 0;
      apply(cur);
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { measure(); apply(cur); });
      document.fonts?.ready.then(() => { measure(); apply(cur); });
    })();

    document.querySelector('.foot-totop')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</Base>
